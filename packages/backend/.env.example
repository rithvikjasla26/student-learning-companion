# Database
DATABASE_URL=postgresql://user:password@localhost:5432/student_companion_db

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_HAIKU_MODEL=claude-3-5-haiku-20241022
CLAUDE_SONNET_MODEL=claude-3-5-sonnet-20241022

# Auth (JWT)
# DEMO MODE: 30d for longer sessions. Change to 7d for production
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=30d

# Email/OTP (stub for MVP)
# DEMO MODE: OTP is hardcoded as "123456" (see auth.service.ts line 23)
# Change SENDGRID_API_KEY in production to enable real email
SENDGRID_API_KEY=SG....
OTP_EXPIRY_MINUTES=30

# App
NODE_ENV=development
BACKEND_PORT=5000

# Frontend URL for CORS - must be set correctly for your deployment
# LOCAL: http://localhost:5173 (Vite dev server)
# PRODUCTION (Render): https://your-frontend-service.onrender.com
FRONTEND_URL=http://localhost:5173

# Spaced Repetition
SCHEDULER_TIMEZONE=Asia/Kolkata
