# Production Environment Variables
# Copy this file to .env and fill in with actual production values
# NEVER commit .env file to version control

# ============================================================================
# DATABASE (Required)
# ============================================================================
# Use a managed database service (AWS RDS, Azure Database, etc.) in production
DATABASE_URL=postgresql://user:password@db.example.com:5432/student_companion_prod

# ============================================================================
# ANTHROPIC API (Required)
# ============================================================================
# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Claude model versions (use latest stable versions)
CLAUDE_HAIKU_MODEL=claude-3-5-haiku-20241022
CLAUDE_SONNET_MODEL=claude-3-5-sonnet-20241022

# ============================================================================
# JWT Authentication (Required)
# ============================================================================
# Generate a strong random secret: openssl rand -base64 32
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# ============================================================================
# OTP/Email Configuration
# ============================================================================
# OTP expiry time (minutes)
OTP_EXPIRY_MINUTES=10

# Email service (Optional: for sending OTP emails)
# Get SendGrid API key from https://sendgrid.com
SENDGRID_API_KEY=SG....

# ============================================================================
# Application Configuration
# ============================================================================
# Environment mode
NODE_ENV=production

# Backend API port (usually 5000, can be changed)
BACKEND_PORT=5000

# Frontend URL (where the React app is hosted)
# Example: https://app.example.com
FRONTEND_URL=https://app.example.com

# ============================================================================
# Timezone Configuration
# ============================================================================
# For scheduler jobs (spaced repetition)
SCHEDULER_TIMEZONE=Asia/Kolkata

# ============================================================================
# NOTES
# ============================================================================
# - Store this .env file securely (use secrets management like GitHub Secrets)
# - Never commit .env to version control
# - Rotate JWT_SECRET regularly
# - Use strong passwords for DATABASE_URL
# - Keep API keys (ANTHROPIC_API_KEY, SENDGRID_API_KEY) secret
# - Test in staging environment before production deployment
# - Monitor logs and health checks regularly
